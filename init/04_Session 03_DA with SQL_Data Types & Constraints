-- Having

-- WHERE
-- фильтрация на уровне строк
-- GROUP BY
-- агрегация
-- HAVING
-- фильтрация на уровне группы

-- Логический порядок выполнения запроса

-- Хотя SQL-код пишется сверху вниз, его выполнение происходит в ином логическом порядке.
--
-- В общих чертах:
--
-- FROM
-- WHERE
-- GROUP BY
-- HAVING
-- SELECT
-- ORDER BY
-- LIMIT

-- Предположим, вы хотите определить товары, которые принесли более 10 000 долларов общей выручки

SELECT
    product_id,
    SUM(sales.total_sales) AS total_revenue
FROM sales
GROUP BY  product_id
HAVING SUM(total_sales) > 10000;

-- Их роли дополняют друг друга:

-- WHERE удаляет ненужные строки на раннем этапе
-- HAVING Применяет бизнес-правила после агрегации

SELECT
  product_id,
  SUM(total_sales) AS total_revenue
FROM sales
WHERE total_sales > 0
GROUP BY product_id
HAVING SUM(total_sales) > 10000;

-- HAVING with COUNT
--  товары, по которым совершено не менее 50 транзакций

SELECT
  product_id,
  COUNT(transaction_id) AS transaction_count
FROM sales
GROUP BY product_id
HAVING COUNT(transaction_id) >= 50;

-- Несколько агрегированных условий можно комбинировать с помощью логических операторов

SELECT
  product_id,
  COUNT(transaction_id) AS transaction_count,
  SUM(total_sales) AS total_revenue
FROM sales
GROUP BY product_id
HAVING
  COUNT(transaction_id) >= 50
  AND SUM(total_sales) > 10000;

